# Flydigi BS-series cooler — HID access for THRM
# USB devices expose ATTRS{idVendor}; Bluetooth HID (uhid) does not,
# so also match the HID parent kernel name (bus:vid:pid.*).

# USB device nodes
SUBSYSTEM=="usb", ATTRS{idVendor}=="37d7", TAG+="uaccess"

# USB HID
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="37d7", MODE="0660", GROUP="input", TAG+="uaccess"

# Bluetooth HID (uhid): parent KERNELS looks like 0005:37D7:1004.XXXX
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="0005:37D7:*", MODE="0660", GROUP="input", TAG+="uaccess"
